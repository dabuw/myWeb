# Backend profile
SPRING_PROFILES_ACTIVE=cloud

# Backend database
DB_HOST=114.132.223.248
DB_PORT=13306
DB_NAME=portfolio_site
DB_USERNAME=root
DB_PASSWORD=123456
DB_USE_SSL=false

# Public domain. Use http:// if TLS is not configured yet.
# Cloud Docker frontend uses 8082 by default; the server's web server should
# proxy this domain to 127.0.0.1:8082.
FRONTEND_PORT=8082
CORS_ALLOWED_ORIGIN=https://dabuw.online

# Leave empty to use the same-origin /api Nginx proxy. This prevents CORS and
# HTTPS mixed-content errors when the site is accessed by domain name.
VITE_API_BASE_URL=
